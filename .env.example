# ============================================================
# Chatbot Citoyen Malien — Configuration Backend
# ============================================================

# Sécurité & API
API_KEY=votre_cle_api_secrete_citoyenne
JWT_SECRET_KEY=votre_cle_secrete_jwt_pour_administrateurs_changez_moi
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Base de Données PostgreSQL
DB_USER=chatbot_user
DB_PASSWORD=Skywalk_Citoyen
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatbot_citoyen

# Communication gRPC avec le DSP (Data Science Package)
DSP_GRPC_HOST=localhost:50051
DSP_TIMEOUT_SECONDS=60
DSP_MOCK_FALLBACK=true

# Environnement
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

